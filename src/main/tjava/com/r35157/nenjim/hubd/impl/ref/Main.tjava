    private static ΩSolanaTransactionSignatureΩ executeJupiterPositionIncrease(
            SolanaSignedTransaction transaction
    ) throws IOException, InterruptedException {
        ObjectMapper objectMapper = new ObjectMapper();

        ObjectNode body = objectMapper.createObjectNode();
        body.put("action", "increase-position");
        body.put(
                "serializedTxBase64",
                transaction.serializedTransaction()
        );

        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(
                        "https://perps-api.jup.ag/v2/transaction/execute"
                ))
                .header("Content-Type", "application/json")
                .header("Accept", "application/json")
                .header("x-client-platform", "nenjim-hub")
                .POST(HttpRequest.BodyPublishers.ofString(
                        objectMapper.writeValueAsString(body)
                ))
                .build();

        HttpResponse<String> response = HttpClient.newHttpClient().send(
                request,
                HttpResponse.BodyHandlers.ofString()
        );

        if (response.statusCode() < 200 || response.statusCode() >= 300) {
            throw new IOException(
                    "Jupiter transaction execution failed with HTTP "
                            + response.statusCode()
                            + ": "
                            + response.body()
            );
        }

        JsonNode root = objectMapper.readTree(response.body());
        JsonNode txid = root.get("txid");

        if (txid == null || !txid.isTextual() || txid.asText().isBlank()) {
            throw new IOException(
                    "Jupiter execution response did not contain txid: "
                            + response.body()
            );
        }

        return txid.asText();
    }

    private static final Logger log = LoggerFactory.getLogger(Main.class);
