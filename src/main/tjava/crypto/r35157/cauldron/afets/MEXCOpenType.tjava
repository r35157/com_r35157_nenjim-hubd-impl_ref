package crypto.r35157.cauldron.afets;

public enum MEXCOpenType {
    Isolated(1),
    Cross(2);

    private final int value;

    MEXCOpenType(int value) {
        this.value = value;
    }

    public int getValue() {
        return value;
    }

    @Override
    public String toString() {
        return String.valueOf(value);
    }
}
